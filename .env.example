# -----------------------------------------------------------------------------
# Variables de entorno de Ruta Protegida.
# Copia este archivo como `.env` y rellena los valores. NUNCA subas `.env` a Git
# (ya está en .gitignore). La clave de OpenAI vive SOLO en el servidor.
# -----------------------------------------------------------------------------

# --- Servidor (endpoint /api/guidance) --- NO exponer al navegador -----------
# Clave de OpenAI. Si se deja vacía, el endpoint responde con el motor local.
OPENAI_API_KEY=
# Modelo a usar (configurable).
OPENAI_MODEL=gpt-4o-mini
# Timeout de la llamada al modelo (ms).
GUIDANCE_TIMEOUT_MS=8000
# Rate limiting: cupo por cliente y recarga por minuto.
GUIDANCE_RATE_CAPACITY=8
GUIDANCE_RATE_PER_MIN=8
# Origen permitido para CORS (dominio del front). '*' solo para pruebas.
ALLOWED_ORIGIN=https://everjulian.github.io
# Puerto del servidor de desarrollo local.
GUIDANCE_PORT=8787

# --- Cliente (Astro) --- SÍ visible en el navegador (no es secreto) ----------
# URL base del endpoint. Si se deja vacía, el sitio usa solo el motor local.
# Ej.: https://tu-funcion.vercel.app  (sin barra final)
PUBLIC_GUIDANCE_API=
