---
// Encabezado fijo con marca y navegación principal.
---
<header>
  <div class="header-inner">
    <button class="brand" data-action="home" aria-label="Ruta Protegida, inicio">
      <span class="brand-mark" data-icon="shield"></span>
      <span><strong>CEPVVS</strong><small>FUNDACIÓN · ECUADOR</small></span>
    </button>
    <nav aria-label="Navegación principal">
      <button data-action="route" id="nav-route">Mi ruta</button>
      <button data-action="library" id="nav-library">Respaldo jurídico</button>
    </nav>
    <button class="button primary header-contact" data-action="contact">
      <span data-icon="message"></span>Hablar con CEPVVS
    </button>
  </div>
</header>
